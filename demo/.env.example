# Spotify credentials for spotify_bridge.py
#
# Copy this file to ".env" in the same directory and fill in your values:
#
#     cp .env.example .env          # Linux / macOS
#     copy .env.example .env        # Windows
#
# ".env" is git-ignored, so your secret stays out of the repository.
# Get these from https://developer.spotify.com/dashboard (see README_spotify.md).
#
# Anything already exported in your shell takes precedence over this file, so you
# can still override a value for a one-off run.

SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here

# Optional. Must match the redirect URI registered on your Spotify app.
#SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
